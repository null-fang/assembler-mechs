		cooling: number,
		batteryMax: number,
		batteryRegen: number,
		weightCapacity: number,
		resistPhysical: number,
		resistHeat: number,
		resistEnergy: number,
	}?,
	legStats: {
		moveRange: number,
	}?,
	weaponStats: Types.WeaponStats?,
