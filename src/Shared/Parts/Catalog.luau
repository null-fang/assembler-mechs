	batteryStats: {
		batteryMaxBonus: number,
		batteryRegenBonus: number,
	}?,
	cpuStats: {
		tier: number,
	}?,
	droneStats: Types.DroneStats?,
}

local function rgb(r: number, g: number, b: number): Color3
	return Color3.fromRGB(r, g, b)
end

local function part(def: CatalogPart): CatalogPart
